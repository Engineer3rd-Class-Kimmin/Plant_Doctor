# Never commit real secrets. Replace these values only in a local .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=180

# Local artifact locations
PLANT_DOCTOR_MODEL_ROOT=C:\path\to\model-root
PLANT_REQUIRE_ALL_MODELS=true
PLANT_DOCTOR_RAG_DIR=C:\path\to\rag-root
RAG_WORK_DIR=C:\path\to\rag-root
RAG_DIR=C:\path\to\rag-root
RAG_INDEX_DIR=C:\path\to\rag-root\rag_embedding_index
RAG_CHUNKS_PATH=C:\path\to\rag-root\rag_chunks.jsonl

# Retrieval
RAG_EMBEDDING_DEVICE=cpu
RAG_TOP_K=10
RAG_MIN_SCORE=0.30
RAG_REQUIRE_HOST_MATCH=true

# Optional Korean weather API
KMA_SERVICE_KEY=
